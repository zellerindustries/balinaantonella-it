{
  "name": "balinaantonella-it",
  "version": "0.0.1",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "mz b --overwrite",
    "start": "npm run build && npx serve ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "lint:html": "htmlhint \"src/pages/**/*.html\"",
    "lint": "npm run lint:html"
  },
  "dependencies": {
    "@minimaz/sitekit": "^0.2.0"
  },
  "devDependencies": {
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "serve": "^14.2.6"
  },
  "allowScripts": {
    "@minimaz/sitekit@0.2.0": true
  }
}
