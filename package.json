{
  "name": "balinaantonella-it",
  "version": "0.0.1",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "mz b --overwrite",
    "start": "npm run build && npx serve ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "lint:html": "htmlhint \"src/pages/**/*.html\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:spelling",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "lint:spelling": "cspell \"src/pages/**/*.html\" --no-progress",
    "lint:a11y": "npm run build && node scripts/lint-a11y.mjs",
    "lint:links": "npm run build && node scripts/lint-links.mjs",
    "check:release": "npm run build && node scripts/check-release.mjs"
  },
  "dependencies": {
    "@minimaz/sitekit": "^0.2.0",
    "bootstrap-icons": "^1.13.2"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.14.0",
    "@cspell/dict-it-it": "^3.1.7",
    "cspell": "^10.5.2",
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "allowScripts": {
    "@minimaz/sitekit@0.2.0": true
  }
}
