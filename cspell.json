{
  "version": "0.2",
  "language": "it,en",
  "import": ["@cspell/dict-it-it/cspell-ext.json"],
  "dictionaries": ["it-it", "en_US"],
  "ignorePaths": ["dist/**", "node_modules/**", "src/scripts/**"],
  "words": [
    "googlebot",
    "Nãgele",
    "Macellum",
    "Aoki",
    "Dantedì",
    "Cardito",
    "Majella",
    "BOBBA",
    "minimaz",
    "webp",
    "favicon",
    "sitemap",
    "noopener",
    "noreferrer",
    "hreflang",
    "noarchive",
    "Balina",
    "Antonella",
    "Pietrasanta"
  ],
  "ignoreRegExpList": [
    "href\\s*=\\s*\"[^\"]*\"",
    "src\\s*=\\s*\"[^\"]*\"",
    "class\\s*=\\s*\"[^\"]*\"",
    "id\\s*=\\s*\"[^\"]*\"",
    "srcset\\s*=\\s*\"[^\"]*\""
  ]
}
